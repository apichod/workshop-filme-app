# Booqable — mêmes identifiants que portail-filme (monespace.filme.fr)
BOOQABLE_COMPANY_SLUG=filme
BOOQABLE_API_KEY=bqbl_xxx

# Supabase — projet existant ou nouveau, il faut juste exécuter supabase.sql dedans
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email (mêmes identifiants que portail-filme — Gmail SMTP)
SMTP_USER=xxx@gmail.com
SMTP_PASS=xxxx

# Emails admin qui reçoivent une alerte quand une session atteint 6 inscrits (séparés par des virgules)
ADMIN_EMAILS=aurelien@filme.fr

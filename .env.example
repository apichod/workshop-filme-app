# Booqable — mêmes identifiants que portail-filme (monespace.filme.fr)
BOOQABLE_COMPANY_SLUG=filme
BOOQABLE_API_KEY=bqbl_xxx

# Supabase — projet existant ou nouveau, il faut juste exécuter supabase.sql dedans
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email (mêmes identifiants que portail-filme — Gmail SMTP)
SMTP_USER=xxx@gmail.com
SMTP_PASS=xxxx

# Emails admin — reçoivent l'alerte "session validée" ET sont les seuls autorisés
# à se connecter sur /admin (séparés par des virgules)
ADMIN_EMAILS=aurelien@filme.fr

# Session admin (générer avec: openssl rand -base64 32)
JWT_SECRET=changez-ceci-par-une-chaine-aleatoire-longue

# URL publique du site, utilisée dans les liens des emails (magic link admin, etc.)
NEXT_PUBLIC_BASE_URL=https://workshop.filme.fr
